{
  "name": "smarttrade-portfolio",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "outputDirectory": "build",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://smarttrade-backend-xdubwwouqq-el.a.run.app/api/$1"
    }
  ],
  "env": {
    "VITE_API_URL": "https://smarttrade-backend-xdubwwouqq-el.a.run.app/api"
  }
}
