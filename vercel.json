{
  "name": "smarttrade-portfolio",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "outputDirectory": "build",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "http://smarttrade-alb-1574969447.ap-south-1.elb.amazonaws.com/api/:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "env": {
    "VITE_API_URL": "/api",
    "BACKEND_API_URL": "http://smarttrade-alb-1574969447.ap-south-1.elb.amazonaws.com"
  }
}
