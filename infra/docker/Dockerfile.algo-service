FROM python:3.12-slim
ARG SERVICE_NAME=strategy-service
ARG PORT=8099
WORKDIR /workspace
RUN useradd -m -u 10001 appuser
COPY libs /workspace/libs
COPY services/${SERVICE_NAME} /workspace/services/${SERVICE_NAME}
WORKDIR /workspace/services/${SERVICE_NAME}
RUN pip install --no-cache-dir \
    -e ../../libs/schemas \
    -e ../../libs/algo-templates \
    -e ../../libs/risk-rules \
    -e ../../libs/market-simulator \
    -e ../../libs/paper-broker \
    -e ../../libs/performance-metrics \
    -e ../../libs/strategy-engine \
    -e ../../libs/algo-platform-store \
    -e . \
    && pip install --no-cache-dir "fastapi>=0.115.6" "uvicorn[standard]>=0.32.1" "numpy>=2.0" "pandas>=2.2"
USER appuser
ENV PORT=${PORT}
EXPOSE ${PORT}
CMD ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port ${PORT}"]
