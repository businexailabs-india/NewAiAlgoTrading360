# Phase 4 — Gated Go-Live flags (ALL default SAFE / OFF)
# Copy values only for UAT after OMS/RMS certification.

LIVE_TRADING_ENABLED=false
ALLOW_STRATEGY_LIVE=false
KILL_SWITCH=false

# Dhan live HTTP (requires real credentials + LIVE_TRADING_ENABLED)
DHAN_USE_MOCK=true
DHAN_ALLOW_LIVE_HTTP=false
DHAN_BASE_URL=https://api.dhan.co
# DHAN_CLIENT_ID=
# DHAN_ACCESS_TOKEN=

# Secrets
SECRET_MANAGER_PROVIDER=local_encrypted
LOCAL_SECRET_KEY=change-this-in-production
SERVICE_HMAC_SECRET=change-this-in-production

# Service URLs
MCP_CONNECTOR_SERVICE_URL=http://localhost:8094
OMS_EXECUTION_URL=http://localhost:8106

# Enable only contracted brokers
MCP_ENABLE_DHAN=true
MCP_ENABLE_ZERODHA=false
