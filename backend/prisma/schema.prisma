// Prisma Schema for SmartTrade Portfolio Optimizer

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  passwordHash  String   @map("password_hash")
  name          String?
  phone         String?
  role          String   @default("user") // user, admin
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations
  brokerConnections  BrokerConnection[]
  holdings           Holding[]
  trades             Trade[]
  settings           UserSettings?
  portfolios         Portfolio[]
  predictionEngines  PredictionEngine[]
  tradingAgents      TradingAgent[]
  orders             Order[]
  strategies         Strategy[]
  knowledgeDocuments KnowledgeDocument[]

  @@map("users")
}

model BrokerConnection {
  id                    String   @id @default(uuid())
  userId                String   @map("user_id")
  broker                String   // zerodha, upstox, angelone
  apiKeyEncrypted       String?  @map("api_key_encrypted")
  accessTokenEncrypted  String?  @map("access_token_encrypted")
  refreshTokenEncrypted String?  @map("refresh_token_encrypted")
  expiresAt             DateTime? @map("expires_at")
  isActive              Boolean  @default(true) @map("is_active")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  // Relations
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  holdings Holding[]
  trades   Trade[]
  orders   Order[]

  @@map("broker_connections")
}

model Holding {
  id                  String   @id @default(uuid())
  userId              String   @map("user_id")
  brokerConnectionId  String   @map("broker_connection_id")
  symbol              String
  exchange            String   // NSE, BSE
  isin                String?
  quantity            Int
  averagePrice        Decimal  @map("average_price") @db.Decimal(10, 2)
  lastPrice           Decimal  @map("last_price") @db.Decimal(10, 2)
  pnl                 Decimal  @db.Decimal(10, 2)
  pnlPercentage       Decimal  @map("pnl_percentage") @db.Decimal(5, 2)
  currentValue        Decimal  @map("current_value") @db.Decimal(12, 2)
  investedValue       Decimal  @map("invested_value") @db.Decimal(12, 2)
  product             String   // CNC, MIS
  updatedAt           DateTime @updatedAt @map("updated_at")

  // Relations
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  brokerConnection BrokerConnection @relation(fields: [brokerConnectionId], references: [id], onDelete: Cascade)

  @@map("holdings")
}

model Trade {
  id                 String   @id @default(uuid())
  userId             String   @map("user_id")
  brokerConnectionId String   @map("broker_connection_id")
  orderId            String?  @map("order_id")
  symbol             String
  exchange           String
  tradeType          String   @map("trade_type") // BUY, SELL
  quantity           Int
  price              Decimal  @db.Decimal(10, 2)
  orderType          String   @map("order_type") // MARKET, LIMIT, SL, SL-M
  product            String   // CNC, MIS, NRML
  status             String   // PENDING, COMPLETE, REJECTED, CANCELLED
  executedAt         DateTime? @map("executed_at")
  createdAt          DateTime @default(now()) @map("created_at")

  // Relations
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  brokerConnection BrokerConnection @relation(fields: [brokerConnectionId], references: [id], onDelete: Cascade)

  @@map("trades")
}

model Portfolio {
  id               String   @id @default(uuid())
  userId           String   @map("user_id")
  name             String
  description      String?
  totalValue       Decimal  @map("total_value") @db.Decimal(12, 2)
  investedValue    Decimal  @map("invested_value") @db.Decimal(12, 2)
  currentValue     Decimal  @map("current_value") @db.Decimal(12, 2)
  totalPnL         Decimal  @map("total_pnl") @db.Decimal(12, 2)
  totalPnLPercent  Decimal  @map("total_pnl_percent") @db.Decimal(5, 2)
  dayPnL           Decimal  @map("day_pnl") @db.Decimal(10, 2)
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("portfolios")
}

model UserSettings {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  settings  Json     // Store all settings as JSON
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model Strategy {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  name            String
  description     String?
  category        String
  code            String   @db.Text
  parameters      Json
  isActive        Boolean  @default(false) @map("is_active")
  backtestResults Json?    @map("backtest_results")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@map("strategies")
}

model MarketData {
  id        String   @id @default(uuid())
  symbol    String
  exchange  String
  open      Decimal  @db.Decimal(10, 2)
  high      Decimal  @db.Decimal(10, 2)
  low       Decimal  @db.Decimal(10, 2)
  close     Decimal  @db.Decimal(10, 2)
  volume    BigInt
  timestamp DateTime
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([symbol, exchange, timestamp])
  @@map("market_data")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  action    String
  resource  String
  details   Json?
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
}

model PredictionEngine {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  name          String
  description   String?
  engineType    String    @map("engine_type")
  symbols       Json
  parameters    Json
  status        String    @default("draft")
  deployTarget  String?   @map("deploy_target")
  deployUrl     String?   @map("deploy_url")
  accuracy      Decimal?  @db.Decimal(5, 2)
  lastTrainedAt DateTime? @map("last_trained_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  predictions PredictionResult[]

  @@index([userId, status])
  @@map("prediction_engines")
}

model PredictionResult {
  id            String   @id @default(uuid())
  engineId      String   @map("engine_id")
  symbol        String
  prediction    Json
  actualOutcome Json?    @map("actual_outcome")
  createdAt     DateTime @default(now()) @map("created_at")

  engine PredictionEngine @relation(fields: [engineId], references: [id], onDelete: Cascade)

  @@index([engineId, symbol])
  @@map("prediction_results")
}

model KnowledgeDocument {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  title     String
  content   String   @db.Text
  docType   String   @default("note") @map("doc_type") // note, research, news, strategy
  symbol    String?
  tags      Json     @default("[]")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, symbol])
  @@map("knowledge_documents")
}

model Order {
  id                 String    @id @default(uuid())
  userId             String    @map("user_id")
  brokerConnectionId String?   @map("broker_connection_id")
  brokerOrderId      String?   @map("broker_order_id")
  symbol             String
  exchange           String    @default("NSE")
  instrumentType     String    @default("EQUITY") @map("instrument_type")
  optionDetails      Json?     @map("option_details")
  tradeType          String    @map("trade_type")
  quantity           Int
  price              Decimal?  @db.Decimal(10, 2)
  triggerPrice       Decimal?  @map("trigger_price") @db.Decimal(10, 2)
  orderType          String    @default("MARKET") @map("order_type")
  product            String    @default("CNC")
  status             String    @default("PENDING")
  isPaper            Boolean   @default(true) @map("is_paper")
  agentId            String?   @map("agent_id")
  rejectionReason    String?   @map("rejection_reason")
  executedAt         DateTime? @map("executed_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  brokerConnection BrokerConnection? @relation(fields: [brokerConnectionId], references: [id])
  agent            TradingAgent?     @relation(fields: [agentId], references: [id])

  @@index([userId, status])
  @@index([agentId])
  @@map("orders")
}

model TradingAgent {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  name          String
  description   String?
  mode          String    @default("paper")
  isActive      Boolean   @default(false) @map("is_active")
  engineId      String?   @map("engine_id")
  config        Json
  lastRunAt     DateTime? @map("last_run_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]
  runs   AgentRun[]

  @@index([userId, isActive])
  @@map("trading_agents")
}

model AgentRun {
  id           String   @id @default(uuid())
  agentId      String   @map("agent_id")
  status       String
  signals      Json?
  ordersPlaced Json?    @map("orders_placed")
  summary      Json?
  error        String?
  createdAt    DateTime @default(now()) @map("created_at")

  agent TradingAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@map("agent_runs")
}

model ScreenerResult {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  criteria  Json
  results   Json
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("screener_results")
}
