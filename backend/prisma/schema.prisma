  symbol          String
  quantity        Decimal  @db.Decimal(20, 8)
  avgPrice        Decimal  @map("avg_price") @db.Decimal(20, 8)
  currentPrice    Decimal? @map("current_price") @db.Decimal(20, 8)
  marketValue     Decimal? @map("market_value") @db.Decimal(20, 8)
  unrealizedPnl   Decimal  @default(0) @map("unrealized_pnl") @db.Decimal(20, 8)
  realizedPnl     Decimal  @default(0) @map("realized_pnl") @db.Decimal(20, 8)
  stopPrice       Decimal? @map("stop_price") @db.Decimal(20, 8)
  targetPrice     Decimal? @map("target_price") @db.Decimal(20, 8)
  strategyId      String?  @map("strategy_id")
  source          MaDataSource @default(SIMULATED)
  openedAt        DateTime @default(now()) @map("opened_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  brokerAccount MaBrokerAccount @relation(fields: [brokerAccountId], references: [id], onDelete: Cascade)

  @@index([brokerAccountId, symbol])
  @@map("ma_positions")
}

model MaOrder {
  id              String   @id @default(uuid())
  brokerAccountId String   @map("broker_account_id")
  signalId        String?  @map("signal_id")
  appOrderId      String   @unique @map("app_order_id")
  idempotencyKey  String   @unique @map("idempotency_key")
  brokerOrderId   String?  @map("broker_order_id")
  strategyId      String?  @map("strategy_id")
  symbol          String
  side            String
  orderType       String   @map("order_type")
  quantity        Decimal  @db.Decimal(20, 8)
  filledQty       Decimal  @default(0) @map("filled_qty") @db.Decimal(20, 8)
  limitPrice      Decimal? @map("limit_price") @db.Decimal(20, 8)
  stopPrice       Decimal? @map("stop_price") @db.Decimal(20, 8)
  targetPrice     Decimal? @map("target_price") @db.Decimal(20, 8)
  status          String
  parentOrderId   String?  @map("parent_order_id")
  role            String   @default("entry") // entry | stop | target
  source          MaDataSource @default(SIMULATED)
  submittedAt     DateTime @default(now()) @map("submitted_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  brokerAccount MaBrokerAccount @relation(fields: [brokerAccountId], references: [id], onDelete: Cascade)
  signal        MaNormalizedSignal? @relation(fields: [signalId], references: [id], onDelete: SetNull)
  events        MaOrderEvent[]
  executions    MaExecution[]

  @@index([brokerAccountId, status])
  @@map("ma_orders")
}

model MaOrderEvent {
  id        String   @id @default(uuid())
  orderId   String   @map("order_id")
  status    String
  detail    String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  order MaOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("ma_order_events")
}

model MaExecution {
  id              String   @id @default(uuid())
  brokerAccountId String   @map("broker_account_id")
  orderId         String?  @map("order_id")
  execId          String   @map("exec_id")
  symbol          String
  qty             Decimal  @db.Decimal(20, 8)
  price           Decimal  @db.Decimal(20, 8)
  commission      Decimal  @default(0) @db.Decimal(20, 8)
  executedAt      DateTime @default(now()) @map("executed_at")
  source          MaDataSource @default(SIMULATED)

  brokerAccount MaBrokerAccount @relation(fields: [brokerAccountId], references: [id], onDelete: Cascade)
  order         MaOrder?        @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([brokerAccountId, execId])
  @@map("ma_executions")
}

model MaTrade {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  symbol      String
  side        String
  qty         Decimal  @db.Decimal(20, 8)
  entryPrice  Decimal  @map("entry_price") @db.Decimal(20, 8)
  exitPrice   Decimal? @map("exit_price") @db.Decimal(20, 8)
  grossPnl    Decimal  @default(0) @map("gross_pnl") @db.Decimal(20, 8)
  netPnl      Decimal  @default(0) @map("net_pnl") @db.Decimal(20, 8)
  fees        Decimal  @default(0) @db.Decimal(20, 8)
  source      MaDataSource @default(SIMULATED)
  openedAt    DateTime @default(now()) @map("opened_at")
  closedAt    DateTime? @map("closed_at")

  @@index([tenantId, openedAt])
  @@map("ma_trades")
}

model MaDailyPerformance {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  day         DateTime @db.Date
  grossPnl    Decimal  @map("gross_pnl") @db.Decimal(20, 8)
  netPnl      Decimal  @map("net_pnl") @db.Decimal(20, 8)
  fees        Decimal  @db.Decimal(20, 8)
  trades      Int      @default(0)
  source      MaDataSource @default(SIMULATED)

  @@unique([tenantId, day, source])
  @@map("ma_daily_performance")
}

model MaEquitySnapshot {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  equity    Decimal  @db.Decimal(20, 8)
  source    MaDataSource @default(SIMULATED)
  at        DateTime @default(now())

  @@index([tenantId, at])
  @@map("ma_equity_snapshots")
}

model MaReconciliationRun {
  id              String   @id @default(uuid())
  brokerAccountId String   @map("broker_account_id")
  status          String
  detail          Json?
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([brokerAccountId, createdAt])
  @@map("ma_reconciliation_runs")
}

model MaSystemHealthEvent {
  id        String   @id @default(uuid())
  tenantId  String?  @map("tenant_id")
  kind      String
  severity  String   @default("info")
  detail    String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId, createdAt])
  @@map("ma_system_health_events")
}

model MaAuditEvent {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  userId    String?  @map("user_id")
  action    String
  entity    String?
  entityId  String?  @map("entity_id")
  detail    Json?
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@map("ma_audit_events")
}

model MaKillSwitch {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  userId    String   @map("user_id")
  active    Boolean  @default(false)
  reason    String?  @db.Text
  updatedAt DateTime @updatedAt @map("updated_at")
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId])
  @@map("ma_kill_switches")
}
