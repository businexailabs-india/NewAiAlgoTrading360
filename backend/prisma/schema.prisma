// Prisma Schema for SmartTrade Portfolio Optimizer

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  passwordHash  String   @map("password_hash")
  name          String?
  phone         String?
  role          String   @default("user") // user, admin
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations
  brokerConnections  BrokerConnection[]
  holdings           Holding[]
  trades             Trade[]
  settings           UserSettings?
  portfolios         Portfolio[]
  predictionEngines  PredictionEngine[]
  tradingAgents      TradingAgent[]
  orders             Order[]
  strategies         Strategy[]
  knowledgeDocuments KnowledgeDocument[]
  knowledgeChunks    KnowledgeChunk[]
  llmAdapters        LlmAdapter[]
  llmTrainingJobs    LlmTrainingJob[]
  mcpServerConfigs   McpServerConfig[]
  executionContext   UserExecutionContext?
  tradingControls    TradingControl[]
  executionAttempts  ExecutionAttempt[]
  tenantMemberships  TenantMembership[]
  ownedTenants       Tenant[]             @relation("TenantOwner")
  watchlists         Watchlist[]
  paperAccounts      PaperAccount[]
  riskProfiles       RiskProfile[]
  riskEvents         RiskEvent[]
  paperStrategies    PaperStrategy[]
  derivativePositions DerivativePosition[]
  userRiskProfiles   UserRiskProfile[]
  capitalRiskPolicies CapitalRiskPolicy[]
  dailyRiskBudgets   DailyRiskBudget[]
  algoSuitabilityScores AlgoSuitabilityScore[]
  liveUnlockRequests LiveUnlockRequest[]
  tradingViewConnections TradingViewConnection[]
  normalizedSignals      NormalizedSignal[]
  paperTestRequests      PaperTestRequest[]
  alertAuditLogs         AlertAuditLog[]
  orderPreviews          OrderPreview[]
  basketOrders           BasketOrder[]
  tradeComplianceAudits  TradeComplianceAudit[]
  executionIntents       ExecutionIntent[]
  strategyApprovals      StrategyApproval[]
  preapprovedRules       PreApprovedExecutionRule[]
  algoSelectionDecisions AlgoSelectionDecision[]
  strategySuitabilityScores StrategySuitabilityScore[]
  rmsDecisions           RmsDecisionRecord[]
  executionAuditEvents   ExecutionAuditEvent[]
  blockedExecutionAttempts BlockedExecutionAttempt[]
  maStrategies             MaStrategy[]
  maWebhookEndpoints       MaWebhookEndpoint[]
  maBrokerAccounts         MaBrokerAccount[]
  maAuditEvents            MaAuditEvent[]
  maKillSwitches           MaKillSwitch[]

  @@map("users")
}

/// Personal tenant — one immutable personal tenant per user (orgs later)
model Tenant {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  kind      String   @default("personal") // personal | organization
  ownerId   String   @map("owner_id")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  owner       User               @relation("TenantOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  memberships TenantMembership[]
  maStrategies      MaStrategy[]
  maWebhookEndpoints MaWebhookEndpoint[]
  maBrokerAccounts  MaBrokerAccount[]
  maAuditEvents     MaAuditEvent[]
  maKillSwitches    MaKillSwitch[]

  @@index([ownerId])
  @@map("tenants")
}

model TenantMembership {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  userId    String   @map("user_id")
  role      String   @default("owner") // owner | admin | member | viewer
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId])
  @@map("tenant_memberships")
}

/// Reliable async event outbox (Kafka/Redpanda dispatcher)
model EventOutbox {
  id             String    @id @default(uuid())
  topic          String
  eventId        String    @unique @map("event_id")
  idempotencyKey String    @map("idempotency_key")
  tenantId       String?   @map("tenant_id")
  userId         String?   @map("user_id")
  payload        Json
  status         String    @default("PENDING") // PENDING | PUBLISHED | FAILED | DEAD
  attempts       Int       @default(0)
  lastError      String?   @map("last_error") @db.Text
  publishedAt    DateTime? @map("published_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@index([userId, topic])
  @@map("event_outbox")
}

model BrokerConnection {
  id                    String   @id @default(uuid())
  userId                String   @map("user_id")
  broker                String   // zerodha, upstox, angelone, dhan
  displayName           String?  @map("display_name")
  externalAccountId     String?  @map("external_account_id")
  clientIdEncrypted     String?  @map("client_id_encrypted")
  credentialsEncrypted  String?  @map("credentials_encrypted") @db.Text
  credentialKeyVersion  Int      @default(1) @map("credential_key_version")
  providerType          String   @default("DIRECT") @map("provider_type") // DIRECT | MCP
  mcpServerConfigId     String?  @map("mcp_server_config_id")
  status                String   @default("PENDING") // PENDING | CONNECTED | EXPIRED | ERROR | DISABLED
  isEnabled             Boolean  @default(true) @map("is_enabled")
  capabilities          Json?    // discovered feature matrix
  lastValidatedAt       DateTime? @map("last_validated_at")
  lastError             String?  @map("last_error") @db.Text
  metadata              Json?
  apiKeyEncrypted       String?  @map("api_key_encrypted")
  accessTokenEncrypted  String?  @map("access_token_encrypted")
  refreshTokenEncrypted String?  @map("refresh_token_encrypted")
  expiresAt             DateTime? @map("expires_at")
  isActive              Boolean  @default(true) @map("is_active")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  // Relations
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  mcpServerConfig  McpServerConfig?  @relation(fields: [mcpServerConfigId], references: [id])
  holdings         Holding[]
  trades           Trade[]
  orders           Order[]
  selectedBy       UserExecutionContext[] @relation("SelectedBroker")
  tradingControls  TradingControl[]
  executionAttempts ExecutionAttempt[]

  @@index([userId, broker, isActive])
  @@index([userId, status, isEnabled])
  @@map("broker_connections")
}

model McpServerConfig {
  id                   String   @id @default(uuid())
  userId               String   @map("user_id")
  name                 String
  provider             String   @default("dhan")
  transport            String   @default("HTTP") // HTTP | SSE | STDIO
  endpoint             String
  command              String?
  args                 Json?
  headersEncrypted     String?  @map("headers_encrypted") @db.Text
  environmentEncrypted String?  @map("environment_encrypted") @db.Text
  authConfigEncrypted  String?  @map("auth_config_encrypted") @db.Text
  credentialKeyVersion Int      @default(1) @map("credential_key_version")
  isEnabled            Boolean  @default(true) @map("is_enabled")
  lastHealthStatus     String?  @map("last_health_status")
  lastHealthCheckedAt  DateTime? @map("last_health_checked_at")
  lastError            String?  @map("last_error") @db.Text
  discoveredTools      Json?    @map("discovered_tools")
  capabilities         Json?
  latencyMs            Int?     @map("latency_ms")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  brokerConnections BrokerConnection[]
  selectedBy        UserExecutionContext[] @relation("SelectedMcp")

  @@index([userId, provider, isEnabled])
  @@map("mcp_server_configs")
}

model UserExecutionContext {
  id                      String   @id @default(uuid())
  userId                  String   @unique @map("user_id")
  activeBrokerConnectionId String? @map("active_broker_connection_id")
  activeMcpServerConfigId String?  @map("active_mcp_server_config_id")
  executionMode           String   @default("PAPER") @map("execution_mode") // PAPER | LIVE
  version                 Int      @default(1)
  updatedAt               DateTime @updatedAt @map("updated_at")
  createdAt               DateTime @default(now()) @map("created_at")

  user                     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeBrokerConnection   BrokerConnection? @relation("SelectedBroker", fields: [activeBrokerConnectionId], references: [id])
  activeMcpServerConfig    McpServerConfig?  @relation("SelectedMcp", fields: [activeMcpServerConfigId], references: [id])

  @@map("user_execution_contexts")
}

model TradingControl {
  id                   String   @id @default(uuid())
  scope                String   // GLOBAL | USER | ACCOUNT
  userId               String?  @map("user_id")
  brokerConnectionId   String?  @map("broker_connection_id")
  liveTradingEnabled   Boolean  @default(false) @map("live_trading_enabled")
  killSwitch           Boolean  @default(false) @map("kill_switch")
  approvalState        String   @default("NONE") @map("approval_state") // NONE | PENDING | APPROVED | REVOKED
  maxOrderValue        Decimal? @map("max_order_value") @db.Decimal(14, 2)
  maxDailyOrderValue   Decimal? @map("max_daily_order_value") @db.Decimal(14, 2)
  maxDailyLoss         Decimal? @map("max_daily_loss") @db.Decimal(14, 2)
  maxOpenExposure      Decimal? @map("max_open_exposure") @db.Decimal(14, 2)
  requirePaperQualify  Boolean  @default(true) @map("require_paper_qualify")
  approvedAt           DateTime? @map("approved_at")
  approvedBy           String?  @map("approved_by")
  notes                String?  @db.Text
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  user             User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  brokerConnection BrokerConnection? @relation(fields: [brokerConnectionId], references: [id], onDelete: Cascade)

  @@unique([scope, userId, brokerConnectionId])
  @@index([scope, liveTradingEnabled])
  @@map("trading_controls")
}

model ExecutionAttempt {
  id                   String   @id @default(uuid())
  userId               String   @map("user_id")
  orderId              String?  @map("order_id")
  brokerConnectionId   String?  @map("broker_connection_id")
  mcpServerConfigId    String?  @map("mcp_server_config_id")
  idempotencyKey       String   @map("idempotency_key")
  source               String   // MANUAL | AGENT | STRATEGY | MCP | SCHEDULER
  requestRedacted      Json?    @map("request_redacted")
  responseRedacted     Json?    @map("response_redacted")
  brokerStatus         String?  @map("broker_status")
  correlationId        String?  @map("correlation_id")
  errorCode            String?  @map("error_code")
  errorMessage         String?  @map("error_message") @db.Text
  reconciledAt         DateTime? @map("reconciled_at")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  brokerConnection BrokerConnection? @relation(fields: [brokerConnectionId], references: [id])

  @@unique([userId, idempotencyKey])
  @@index([orderId])
  @@index([correlationId])
  @@map("execution_attempts")
}

model Holding {
  id                  String   @id @default(uuid())
  userId              String   @map("user_id")
  brokerConnectionId  String   @map("broker_connection_id")
  symbol              String
  exchange            String   // NSE, BSE
  isin                String?
  quantity            Int
  averagePrice        Decimal  @map("average_price") @db.Decimal(10, 2)
  lastPrice           Decimal  @map("last_price") @db.Decimal(10, 2)
  pnl                 Decimal  @db.Decimal(10, 2)
  pnlPercentage       Decimal  @map("pnl_percentage") @db.Decimal(5, 2)
  currentValue        Decimal  @map("current_value") @db.Decimal(12, 2)
  investedValue       Decimal  @map("invested_value") @db.Decimal(12, 2)
  product             String   // CNC, MIS
  updatedAt           DateTime @updatedAt @map("updated_at")

  // Relations
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  brokerConnection BrokerConnection @relation(fields: [brokerConnectionId], references: [id], onDelete: Cascade)

  @@map("holdings")
}

model Trade {
  id                 String   @id @default(uuid())
  userId             String   @map("user_id")
  brokerConnectionId String   @map("broker_connection_id")
  orderId            String?  @map("order_id")
  symbol             String
  exchange           String
  tradeType          String   @map("trade_type") // BUY, SELL
  quantity           Int
  price              Decimal  @db.Decimal(10, 2)
  orderType          String   @map("order_type") // MARKET, LIMIT, SL, SL-M
  product            String   // CNC, MIS, NRML
  status             String   // PENDING, COMPLETE, REJECTED, CANCELLED
  executedAt         DateTime? @map("executed_at")
  createdAt          DateTime @default(now()) @map("created_at")

  // Relations
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  brokerConnection BrokerConnection @relation(fields: [brokerConnectionId], references: [id], onDelete: Cascade)

  @@map("trades")
}

model Portfolio {
  id               String   @id @default(uuid())
  userId           String   @map("user_id")
  name             String
  description      String?
  totalValue       Decimal  @map("total_value") @db.Decimal(12, 2)
  investedValue    Decimal  @map("invested_value") @db.Decimal(12, 2)
  currentValue     Decimal  @map("current_value") @db.Decimal(12, 2)
  totalPnL         Decimal  @map("total_pnl") @db.Decimal(12, 2)
  totalPnLPercent  Decimal  @map("total_pnl_percent") @db.Decimal(5, 2)
  dayPnL           Decimal  @map("day_pnl") @db.Decimal(10, 2)
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("portfolios")
}

model UserSettings {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  settings  Json     // Store all settings as JSON
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model Strategy {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  name            String
  description     String?
  category        String
  code            String   @db.Text
  parameters      Json
  isActive        Boolean  @default(false) @map("is_active")
  backtestResults Json?    @map("backtest_results")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@map("strategies")
}

model MarketData {
  id        String   @id @default(uuid())
  symbol    String
  exchange  String
  open      Decimal  @db.Decimal(10, 2)
  high      Decimal  @db.Decimal(10, 2)
  low       Decimal  @db.Decimal(10, 2)
  close     Decimal  @db.Decimal(10, 2)
  volume    BigInt
  timestamp DateTime
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([symbol, exchange, timestamp])
  @@map("market_data")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  action    String
  resource  String
  details   Json?
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
}

model PredictionEngine {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  name          String
  description   String?
  engineType    String    @map("engine_type")
  symbols       Json
  parameters    Json
  status        String    @default("draft")
  deployTarget  String?   @map("deploy_target")
  deployUrl     String?   @map("deploy_url")
  accuracy      Decimal?  @db.Decimal(5, 2)
  lastTrainedAt DateTime? @map("last_trained_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  predictions PredictionResult[]

  @@index([userId, status])
  @@map("prediction_engines")
}

model PredictionResult {
  id            String   @id @default(uuid())
  engineId      String   @map("engine_id")
  symbol        String
  prediction    Json
  actualOutcome Json?    @map("actual_outcome")
  createdAt     DateTime @default(now()) @map("created_at")

  engine PredictionEngine @relation(fields: [engineId], references: [id], onDelete: Cascade)

  @@index([engineId, symbol])
  @@map("prediction_results")
}

model KnowledgeDocument {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  title     String
  content   String   @db.Text
  docType   String   @default("note") @map("doc_type") // note, research, news, strategy
  symbol    String?
  tags      Json     @default("[]")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user   User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  chunks KnowledgeChunk[]

  @@index([userId, symbol])
  @@map("knowledge_documents")
}

model KnowledgeChunk {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  documentId String   @map("document_id")
  chunkIndex Int      @map("chunk_index")
  text       String   @db.Text
  symbol     String?
  embedding  Json     @default("[]")
  createdAt  DateTime @default(now()) @map("created_at")

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  document KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([documentId])
  @@map("knowledge_chunks")
}

model LlmAdapter {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  name        String
  baseModel   String   @map("base_model")
  adapterType String   @default("lora") @map("adapter_type")
  s3Path      String?  @map("s3_path")
  status      String   @default("ready")
  metrics     Json?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("llm_adapters")
}

model LlmTrainingJob {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  name        String
  baseModel   String    @map("base_model")
  trainType   String    @default("qlora") @map("train_type")
  status      String    @default("queued")
  config      Json      @default("{}")
  metrics     Json?
  adapterPath String?   @map("adapter_path")
  error       String?
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("llm_training_jobs")
}

model Order {
  id                 String    @id @default(uuid())
  userId             String    @map("user_id")
  brokerConnectionId String?   @map("broker_connection_id")
  brokerOrderId      String?   @map("broker_order_id")
  symbol             String
  exchange           String    @default("NSE")
  instrumentType     String    @default("EQUITY") @map("instrument_type")
  optionDetails      Json?     @map("option_details")
  tradeType          String    @map("trade_type")
  quantity           Int
  price              Decimal?  @db.Decimal(10, 2)
  triggerPrice       Decimal?  @map("trigger_price") @db.Decimal(10, 2)
  orderType          String    @default("MARKET") @map("order_type")
  product            String    @default("CNC")
  status             String    @default("PENDING")
  isPaper            Boolean   @default(true) @map("is_paper")
  agentId            String?   @map("agent_id")
  source             String?   @default("MANUAL")
  meta               Json?
  rejectionReason    String?   @map("rejection_reason")
  executedAt         DateTime? @map("executed_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  brokerConnection BrokerConnection? @relation(fields: [brokerConnectionId], references: [id])
  agent            TradingAgent?     @relation(fields: [agentId], references: [id])

  @@index([userId, status])
  @@index([agentId])
  @@map("orders")
}

model TradingAgent {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  name          String
  description   String?
  mode          String    @default("paper")
  isActive      Boolean   @default(false) @map("is_active")
  engineId      String?   @map("engine_id")
  config        Json
  lastRunAt     DateTime? @map("last_run_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]
  runs   AgentRun[]

  @@index([userId, isActive])
  @@map("trading_agents")
}

model AgentRun {
  id           String   @id @default(uuid())
  agentId      String   @map("agent_id")
  status       String
  signals      Json?
  ordersPlaced Json?    @map("orders_placed")
  summary      Json?
  error        String?
  createdAt    DateTime @default(now()) @map("created_at")

  agent TradingAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@map("agent_runs")
}

model ScreenerResult {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  criteria  Json
  results   Json
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("screener_results")
}

model Watchlist {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  name      String
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items WatchlistItem[]

  @@index([userId])
  @@unique([userId, name])
  @@map("watchlists")
}

model WatchlistItem {
  id          String   @id @default(uuid())
  watchlistId String   @map("watchlist_id")
  symbol      String
  exchange    String   @default("NSE")
  notes       String?
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")

  watchlist Watchlist @relation(fields: [watchlistId], references: [id], onDelete: Cascade)

  @@unique([watchlistId, symbol, exchange])
  @@index([watchlistId])
  @@map("watchlist_items")
}

/// NSE/BSE F&O underlying (NIFTY, BANKNIFTY, RELIANCE, …) — never hardcode strikes here
model DerivativeUnderlying {
  id           String   @id @default(uuid())
  symbol       String
  exchange     String   @default("NSE")
  segment      String   @default("NFO") // NFO | BFO
  name         String?
  instrumentKind String @default("INDEX") // INDEX | STOCK
  lotSizeHint  Int?     @map("lot_size_hint")
  tickSize     Float?   @map("tick_size")
  brokerSource String   @default("dhan") @map("broker_source")
  tradable     Boolean  @default(true)
  syncedAt     DateTime? @map("synced_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  instruments DerivativeInstrument[]

  @@unique([symbol, exchange, segment])
  @@index([tradable])
  @@map("derivative_underlyings")
}

model DerivativeInstrument {
  id               String    @id @default(uuid())
  underlyingId     String    @map("underlying_id")
  exchange         String    @default("NSE")
  segment          String    @default("NFO")
  tradingSymbol    String    @map("trading_symbol")
  instrumentToken  String    @map("instrument_token")
  instrumentType   String    // CE | PE | FUT
  optionType       String?   @map("option_type") // CE | PE | null for FUT
  strike           Float?
