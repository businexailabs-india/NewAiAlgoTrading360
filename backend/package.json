{
  "name": "smarttrade-backend",
  "version": "1.0.0",
  "description": "Backend API for SmartTrade Portfolio Optimizer",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --exec \"ts-node --transpile-only\" src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "collect-data": "ts-node scripts/collect-historical-data.ts",
    "collect-data:5y": "ts-node scripts/collect-historical-data.ts 5",
    "verify:dhan-mcp": "ts-node --transpile-only scripts/verify-dhan-mcp.ts",
    "test:unit": "ts-node --transpile-only scripts/unit-encryption-capabilities.ts && ts-node --transpile-only scripts/unit-llm-providers.ts && ts-node --transpile-only scripts/unit-advisory-outbox.ts && ts-node --transpile-only scripts/unit-options-phase1.ts && ts-node --transpile-only scripts/unit-options-phase2.ts && ts-node --transpile-only scripts/unit-options-quotes.ts && ts-node --transpile-only scripts/unit-options-oms.ts && ts-node --transpile-only scripts/unit-strategy-bind.ts && ts-node --transpile-only scripts/unit-options-polish.ts",
    "test:acceptance:paper": "ts-node --transpile-only scripts/paper-acceptance.ts",
    "seed:paper-agent": "ts-node --transpile-only scripts/seed-paper-agent.ts",
    "dhanhq:sidecar": "cd ../services/dhanhq-sidecar && uvicorn app.main:app --host 0.0.0.0 --port 8099 --reload",
    "dhanhq:smoke": "cd ../services/dhanhq-sidecar && python scripts/smoke_dhanhq.py",
    "dhanhq:chain": "cd ../services/dhanhq-sidecar && python scripts/research_option_chain.py",
    "test:risk-journey": "ts-node --transpile-only scripts/unit-risk-journey-1lakh.ts",
    "test:tradingview": "ts-node --transpile-only scripts/unit-tradingview-connect.ts",
    "test:trading-terminal": "ts-node --transpile-only scripts/unit-trading-terminal.ts",
    "test:execution-governance": "ts-node --transpile-only scripts/unit-execution-governance.ts",
    "test:market-analytics": "ts-node --transpile-only scripts/unit-market-analytics.ts",
    "test:unlock:live": "ts-node --transpile-only scripts/live-unlock.ts",
    "test:unit:oms": "ts-node --transpile-only scripts/unit-options-oms.ts",
    "test:advisory": "powershell -File ../scripts/run-advisory-tests.ps1",
    "ml:dev": "cd ml-service && uvicorn main:app --host 0.0.0.0 --port 8081 --reload",
    "llm:dev": "cd llm-service && uvicorn main:app --host 0.0.0.0 --port 8082 --reload",
    "bifrost:up": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/start-bifrost.ps1",
    "bifrost:docker": "docker compose -f ../docker-compose.bifrost.yml --env-file .env up -d",
    "bifrost:docker:down": "docker compose -f ../docker-compose.bifrost.yml --env-file .env down",
    "deploy:aws": "powershell -File ../aws/deploy-full.ps1",
    "deploy:cloud-run": "powershell -File deploy-gcp.ps1 -DeploymentType cloud-run",
    "deploy:app-engine": "powershell -File deploy-gcp.ps1 -DeploymentType app-engine",
    "deploy:compute": "powershell -File deploy-gcp.ps1 -DeploymentType compute-engine",
    "gcp:set-env": "powershell -File set-gcp-env.ps1"
  },
  "keywords": [
    "trading",
    "portfolio",
    "zerodha",
    "upstox",
    "api"
  ],
  "author": "AlgoTradingV360",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1079.0",
    "@prisma/client": "^5.7.0",
    "@supabase/supabase-js": "^2.39.0",
    "axios": "^1.6.2",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "crypto-js": "^4.2.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "redis": "^4.6.11",
    "socket.io": "^4.6.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/crypto-js": "^4.2.1",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.10.5",
    "nodemon": "^3.0.2",
    "prisma": "^5.7.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "prisma@5.22.0": true,
    "@prisma/engines@5.22.0": true
  }
}
