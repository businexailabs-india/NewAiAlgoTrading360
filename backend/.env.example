# Server Configuration
NODE_ENV=development
PORT=3001
API_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# Database (AWS RDS PostgreSQL in production)
DATABASE_URL="postgresql://smarttrade:password@localhost:5432/smarttrade?schema=public"

# AWS (production)
AWS_REGION=ap-south-1
AWS_S3_DATA_BUCKET=
AWS_PREDICTION_URL=
BACKEND_API_URL=

# Redis
REDIS_URL=redis://localhost:6379

# JWT Secrets
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=your-refresh-token-secret-change-this

# Encryption
ENCRYPTION_KEY=your-32-byte-encryption-key-here

# Zerodha Kite Connect
ZERODHA_API_KEY=your_zerodha_api_key
ZERODHA_API_SECRET=your_zerodha_api_secret
ZERODHA_REDIRECT_URL=http://localhost:3001/api/broker/zerodha/callback

# Upstox API
UPSTOX_API_KEY=your_upstox_api_key
UPSTOX_API_SECRET=your_upstox_api_secret
UPSTOX_REDIRECT_URL=http://localhost:3001/api/broker/upstox/callback

# AngelOne API
ANGELONE_API_KEY=your_angelone_api_key
ANGELONE_API_SECRET=your_angelone_api_secret

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log

# QuantConnect
QC_USER_ID=your_quantconnect_user_id
QC_API_TOKEN=your_quantconnect_api_token
QC_BASE_URL=https://api.quantconnect.com

# Deployment targets for prediction engines (AWS only in production)
AWS_PREDICTION_URL=https://your-api.execute-api.ap-south-1.amazonaws.com/prod/predict
AWS_REGION=ap-south-1
AWS_S3_DATA_BUCKET=your-smarttrade-data-bucket

# Market data: yahoo | dhan (dhan needs Data API subscription)
MARKET_DATA_PROVIDER=yahoo

# DhanHQ API (https://dhanhq.co/)
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=
DHAN_APP_NAME=

# Live trading kill/env gate (paper-first). Also requires DB TradingControl approval.
LIVE_TRADING_ENABLED=false
ENCRYPTION_KEY_VERSION=1

# Python ML sidecar (FastAPI + scikit-learn + semantic RAG)
ML_SERVICE_URL=http://localhost:8081
USE_PYTHON_ML=true

# LLM — LoRA/QLoRA training service
LLM_SERVICE_URL=http://localhost:8082
LLM_BASE_MODEL=sshleifer/tiny-gpt2
LLM_GPU_ENABLED=false

# Ollama local LLM (optional)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# OpenAI (optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Pluggable LLM providers (AI Advisory Service)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-08-01-preview
DEFAULT_LLM_PROVIDER=claude
FALLBACK_LLM_PROVIDER=local
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LOCAL_LLM_MODE=
ALLOW_MOCK_LLM=false

# AI Algo Advisory services (internal)
AI_ADVISORY_SERVICE_URL=http://localhost:8091
PAPER_TEST_SERVICE_URL=http://localhost:8092
EXTERNAL_ALGO_SERVICE_URL=http://localhost:8093
MCP_CONNECTOR_SERVICE_URL=http://localhost:8094
SERVICE_HMAC_SECRET=dev-service-hmac-secret-change-me
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
OUTBOX_DISPATCH_INTERVAL_MS=5000

# DhanLaxmi multilingual assistant
DHANLAXMI_SERVICE_URL=http://localhost:8095
VOICE_GATEWAY_SERVICE_URL=http://localhost:8096
LANGUAGE_INTENT_SERVICE_URL=http://localhost:8097
TRADE_APPROVAL_SERVICE_URL=http://localhost:8098
DEFAULT_LLM_PROVIDER=mock
FALLBACK_LLM_PROVIDER=local
DEFAULT_STT_PROVIDER=mock
DEFAULT_TTS_PROVIDER=mock
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
AZURE_SPEECH_KEY=
GOOGLE_SPEECH_KEY=
AWS_TRANSCRIBE_CONFIG=

# Session
SESSION_SECRET=your-session-secret-change-this
