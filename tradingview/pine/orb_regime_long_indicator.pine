//@version=6
// BxAi Trade Market Analytics — Regime-filtered Opening Range Breakout (INDICATOR)
// Paper / research signals only. Does NOT place broker orders.
// TradingView backtest fills differ from broker paper and live fills.
indicator("BxAi ORB Regime Long (Indicator)", shorttitle="BxAi ORB Ind", overlay=true, max_labels_count=500)

openingRangeMinutes = input.int(30, "Opening range minutes")
emaPeriod = input.int(50, "EMA period")
atrPeriod = input.int(14, "ATR period")
volLookback = input.int(20, "Volume lookback")
volMult = input.float(1.20, "Volume multiplier")
rr = input.float(1.50, "Reward / risk")
atrStopMult = input.float(1.0, "ATR stop multiplier")
useStructural = input.bool(true, "Use structural stop")
minStopPct = input.float(0.001, "Min stop distance %")
sessionStart = input.string("0930-1600", "RTH session (exchange)")
maxSignalsDay = input.int(2, "Max signals per day")
alertMode = input.string("confirmed", "Alert mode", options=["confirmed"])

tz = syminfo.timezone
t = time("", sessionStart, tz)
inSession = not na(t)
barConfirmed = barstate.isconfirmed

sessionDate = time("D", timezone=tz)
newDay = ta.change(sessionDate) != 0

var float orHigh = na
var float orLow = na
var bool orComplete = false
var int orBars = 0
var int signalsToday = 0
var float lastBreakoutLevel = na

barsNeeded = math.max(1, math.ceil(openingRangeMinutes / timeframe.in_seconds() * 60))
// Prefer 15m chart: openingRangeMinutes/15

if newDay
    orHigh := na
    orLow := na
    orComplete := false
    orBars := 0
    signalsToday := 0
    lastBreakoutLevel := na

if inSession and not orComplete and barConfirmed
    orBars += 1
    orHigh := na(orHigh) ? high : math.max(orHigh, high)
    orLow := na(orLow) ? low : math.min(orLow, low)
    if orBars >= math.max(1, int(openingRangeMinutes / 15))
        orComplete := true

ema50 = ta.ema(close, emaPeriod)
emaSlope = ema50 - ema50[3]
sessionVwap = ta.vwap
atr = ta.atr(atrPeriod)
avgVol = ta.sma(volume, volLookback)

longCond = barConfirmed and orComplete and close > orHigh and close > sessionVwap and close > ema50 and emaSlope > 0 and volume >= volMult * avgVol and signalsToday < maxSignalsDay and (na(lastBreakoutLevel) or orHigh != lastBreakoutLevel)

entryPx = close
atrStop = close - atrStopMult * atr
structStop = useStructural ? low : atrStop
stopPx = math.max(atrStop, structStop)
minDist = close * minStopPct
if close - stopPx < minDist
    stopPx := close - minDist
stopDist = entryPx - stopPx
targetPx = entryPx + rr * stopDist

if longCond
    signalsToday += 1
    lastBreakoutLevel := orHigh
    label.new(bar_index, high, "ORB LONG", style=label.style_label_down, color=color.new(color.teal, 20), textcolor=color.white)
else if barConfirmed and orComplete and close > orHigh and not longCond
    reason = close <= sessionVwap ? "VWAP" : close <= ema50 ? "EMA" : emaSlope <= 0 ? "slope" : volume < volMult * avgVol ? "volume" : "other"
    label.new(bar_index, low, "RJ " + reason, style=label.style_label_up, color=color.new(color.gray, 40), textcolor=color.white, size=size.tiny)

plot(orHigh, "OR High", color=color.orange)
plot(orLow, "OR Low", color=color.orange)
plot(ema50, "EMA50", color=color.aqua)
plot(sessionVwap, "VWAP", color=color.yellow)
plotshape(longCond, title="Long", style=shape.triangleup, location=location.belowbar, color=color.teal, size=size.small)
bgcolor(inSession and not orComplete ? color.new(color.orange, 90) : na)

plot(longCond ? entryPx : na, "Entry", color=color.green, style=plot.style_circles)
plot(longCond ? stopPx : na, "Stop", color=color.red, style=plot.style_circles)
plot(longCond ? targetPx : na, "Target", color=color.lime, style=plot.style_circles)

alertcondition(longCond, title="ORB Long Entry", message="BxAi ORB long signal (confirmed bar)")

if longCond
    alert('{"schema_version":"1.0","secret":"{{secret}}","strategy_id":"orb-v1","signal_id":"' + syminfo.ticker + '-' + timeframe.period + '-' + str.tostring(time) + '-long","event":"entry_signal","symbol":"' + syminfo.ticker + '","exchange":"' + syminfo.prefix + '","timeframe":"' + timeframe.period + '","bar_time":"' + str.format_time(time, "yyyy-MM-dd\'T\'HH:mm:ssXXX", tz) + '","side":"buy","reference_price":' + str.tostring(close, "#.####") + ',"opening_range_high":' + str.tostring(orHigh, "#.####") + ',"opening_range_low":' + str.tostring(orLow, "#.####") + ',"vwap":' + str.tostring(sessionVwap, "#.####") + ',"ema":' + str.tostring(ema50, "#.####") + ',"atr":' + str.tostring(atr, "#.####") + ',"stop_price":' + str.tostring(stopPx, "#.####") + ',"target_price":' + str.tostring(targetPx, "#.####") + ',"timestamp":' + str.tostring(timenow) + '}', alert.freq_once_per_bar_close)
